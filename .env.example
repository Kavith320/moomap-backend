# Copy this file to .env and fill in real values:  cp .env.example .env

# --- Server ---
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=3001
# Optional: frontend API base URL (defaults to http://localhost:${BACKEND_PORT})
# NEXT_PUBLIC_API_URL=http://localhost:3000

# --- MongoDB (required) ---
MONGO_URI=mongodb://localhost:27017/moomap

# --- Auth (JWT_SECRET required) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=1h

# --- Default admin (seeded on first start if no admin exists) ---
ADMIN_MOBILE=0771234567
ADMIN_PASSWORD=admin1234

# --- MQTT ---
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=cc/+/payload
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=

# --- Alerts ---
# Consecutive GPS readings that must agree before a geofence exit/enter alert fires
GEOFENCE_CONFIRM_READINGS=2
LOW_BATTERY_PERCENT=20
OFFLINE_AFTER_MINUTES=60
# Optional: every alert is also POSTed here as JSON (e.g. an SMS/Telegram/n8n bridge)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
