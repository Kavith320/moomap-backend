# Copy to simulator/.env  (cp .env.example .env)

# --- Where the system is ---
BACKEND_URL=http://localhost:3000
# On the server: the local Mosquitto. From a laptop: wss://moomap-localserver.taile78ad3.ts.net/mqtt
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=simulator
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=cc
# slave  = master relays each slave on cc/<slaveId>/payload
# master = master relays everything on its own topic cc/<masterId>/payload (device_id identifies the slave)
RELAY_TOPIC=slave

# --- Simulated farmer (created by `npm run setup`, log in to the portal with these) ---
SIM_USER_FIRST_NAME=Sim
SIM_USER_LAST_NAME=Farmer
SIM_USER_MOBILE=0700000001
SIM_USER_PASSWORD=simfarmer123

# --- Herd ---
HERD_SIZE=8
MASTERS=1
CENTER_LAT=7.2906
CENTER_LON=80.6337
PASTURE_RADIUS_M=250
# Collar / cattle IDs start with this (SIM-M01, SIM-S01, SIM-COW-01)
ID_PREFIX=SIM
FENCE_NAME=Sim pasture

# --- Timing ---
SLAVE_INTERVAL_S=30
MASTER_INTERVAL_S=30
# Cow movement speed-up (1 = real time)
TIME_SCALE=1

# --- GPS / battery ---
GPS_NOISE_M=3
GPS_INVALID_RATE=0.02
BATTERY_START=95
BATTERY_DRAIN_PER_TX=0.01

# --- LoRa radio (slave -> master) ---
LORA_FREQ_MHZ=868
LORA_SF=9
LORA_BW_KHZ=125
LORA_TX_DBM=14
LORA_PATHLOSS_EXP=3.3
LORA_BODY_LOSS_DB=10
LORA_SHADOWING_DB=4
LORA_RANDOM_LOSS=0.02
LORA_DUTY_CYCLE=0.01
LORA_FRAME_BYTES=18

SIM_SEED=42

# --- Control port (localhost only) for `npm run cmd -- <command>` ---
CONTROL_PORT=7070
